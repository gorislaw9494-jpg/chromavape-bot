# Токен бота из @BotFather
BOT_TOKEN=

# Telegram ID администраторов (через запятую). Узнать свой ID: @userinfobot
ADMIN_IDS=

# Название магазина (отображается в боте)
SHOP_NAME=VapeShop

# Контакты поддержки (текст, необязательно)
SUPPORT_CONTACT=@your_support

# Путь к файлу базы данных
DB_PATH=shop.db
